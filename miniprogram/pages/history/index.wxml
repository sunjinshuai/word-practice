<view class="screen"><text wx:if="{{!rounds.length}}">还没有默写记录</text><view wx:for="{{rounds}}" wx:key="id" class="section" data-index="{{index}}" bindtap="toggle"><view>{{item.date}}</view><view>{{item.unit}} · {{item.finished?'已完成':'未结束'}} · {{item.answers.length}} / {{item.total}} 题</view><view>正确 {{item.correct}}　错误 {{item.wrong}}　{{item.accuracy}}%　{{item.seconds}} 秒</view><view wx:if="{{item.open}}"><view wx:for="{{item.answers}}" wx:for-item="answer" wx:key="id" class="answer {{answer.correct?'good':'bad'}}"><view>{{answer.en}} · {{answer.zh}}</view><view>{{answer.skipped?'跳过':answer.typed}}　{{answer.correct?'✓':'×'}}</view></view></view></view></view>