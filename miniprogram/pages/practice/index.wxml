<view class="screen"><view class="row toolbar"><button size="mini" bindtap="openSetup">设置</button><button size="mini" bindtap="history">默写情况</button><button size="mini" bindtap="toggleSound">{{sound?'声音开':'声音关'}}</button></view><view class="progress"><view style="width:{{state.percent}}%"></view></view><text class="hint">{{state.completed || 0}} / {{state.total}}</text><view wx:if="{{state.item}}"><view class="prompt">{{settings.direction==='en'?state.item.zh:state.item.en}}</view><button class="read" size="mini" bindtap="read">♫ 朗读</button><letter-grid wx:if="{{settings.direction==='en'}}" words="{{state.words}}" value="{{state.inputValue}}" judged="{{state.judged}}" ok="{{state.ok}}" bindtyping="typing" /><view wx:else=""><input class="chinese" placeholder="输入中文释义" value="{{chinese}}" disabled="{{state.judged}}" bindinput="chineseInput" /><button wx:if="{{!state.judged}}" bindtap="submit">提交</button><view wx:if="{{state.judged}}">{{state.item.zh}}</view><letter-grid wx:if="{{state.judged && state.ok}}" words="{{state.words}}" judged="{{true}}" ok="{{true}}" /></view><phonics-panel text="{{state.phonics}}" /><button wx:if="{{!state.judged}}" class="skip" bindtap="skip">不会 / 跳过</button><button wx:else="" class="next" bindtap="next">{{state.last?'查看本轮结果':'下一题'}}</button></view><view wx:else="" class="empty"><text>{{state.total?'本轮练习完成':'选择范围，开始练习'}}</text><button bindtap="openSetup">重新随机</button><button bindtap="toggleExtra">错题本 / 查看词库</button><view wx:if="{{extra}}"><view class="section">错题本 {{mistakes.length}} 项</view><view wx:for="{{mistakes}}" wx:key="id">{{item.en}} · {{item.zh}}<button size="mini" data-id="{{item.id}}" bindtap="removeMistake">移出错题本</button></view><view class="section">复习时间表</view><view wx:for="{{reviews}}" wx:key="id">{{item.en}} · {{item.due}}</view><view class="section">所选词库 {{bank.length}} 项</view><view wx:for="{{bank}}" wx:key="id">{{item.en}} · {{item.zh}}</view></view></view><view class="stats"><view>正确<text>{{state.correct}}</text></view><view>错误 / 跳过<text>{{state.wrong}}</text></view><view>正确率<text>{{state.accuracy}}%</text></view></view><text class="hint">{{notice}}</text></view><setup-panel visible="{{setup}}" bindstart="start" /><particle-layer trigger="{{particles}}" />