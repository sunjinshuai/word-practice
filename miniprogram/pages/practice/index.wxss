.toolbar {
  justify-content: space-between;
}
.progress {
  height: 8rpx;
  background: #3d4554;
  border-radius: 8rpx;
  margin: 28rpx 0 12rpx;
  overflow: hidden;
}
.progress view {
  height: 100%;
  background: #a8d6b5;
  transition: width 0.3s;
}
.prompt {
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  padding: 70rpx 0 32rpx;
  line-height: 1.5;
}
.read {
  display: block;
  margin: auto;
  background: transparent;
  color: #b5dbc1;
}
.skip {
  background: transparent;
  color: #a9b3c4;
  margin: 40rpx auto;
}
.next {
  margin: 40rpx auto;
  max-width: 460rpx;
}
.stats {
  display: flex;
  justify-content: space-around;
  margin: 60rpx 0;
  color: #a9b3c4;
  text-align: center;
  font-size: 25rpx;
}
.stats text {
  display: block;
  font-size: 38rpx;
  color: #eef0f6;
  margin-top: 20rpx;
}
.empty {
  padding: 50rpx 0;
  line-height: 2;
}
.empty button {
  margin: 20rpx 0;
}
.chinese {
  background: #303846;
  padding: 24rpx;
  border-radius: 12rpx;
  margin: 32rpx 0;
}
/* Secondary actions keep the spelling area visually dominant. */
.toolbar { gap: 8rpx; }
.toolbar button[size="mini"] { margin: 0; padding: 0 18rpx; height: 88rpx; min-height: 88rpx; line-height: 88rpx; font-size: 25rpx; background: transparent; color: #b1bbc9; }
.prompt { padding: 48rpx 0 20rpx; font-size: 44rpx; overflow-wrap: break-word; }
button.read[size="mini"] { display: block; width: 180rpx; margin: 0 auto; padding: 0; line-height: 88rpx; height: 88rpx; font-size: 28rpx; background: transparent; }
.next { width: 100%; max-width: 420rpx; background: #b5dbc1; color: #24352c; line-height: 88rpx; padding: 0 24rpx; }
.skip { line-height: 88rpx; padding: 0 24rpx; margin: 24rpx auto; }
.stats { margin: 40rpx 0 28rpx; gap: 12rpx; }
.stats view { flex: 1; font-size: 24rpx; }
.stats text { margin-top: 12rpx; font-size: 36rpx; }
.chinese { min-height: 88rpx; height: auto; color: #edf0f5; }
@media (max-width: 350px) { .prompt { font-size: 38rpx; } .toolbar button[size="mini"] { padding: 0 12rpx; } }
