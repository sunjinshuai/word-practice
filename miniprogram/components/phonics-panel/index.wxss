.guide {
  background: #2b313d;
  border-radius: 20rpx;
  padding: 26rpx;
  font-size: 25rpx;
  color: #b6bdca;
}
.entry {
  margin-top: 26rpx;
  line-height: 1.8;
}
.name {
  color: #e9edf5;
  font-size: 32rpx;
}
.cuts {
  font-size: 36rpx;
  padding: 14rpx 0;
}
.actions {
  display: flex;
  gap: 12rpx;
  margin: 15rpx 0;
}
button {
  background: #b5dbc1;
  color: #202532;
  border-radius: 14rpx;
}
button::after {
  border: none;
}
