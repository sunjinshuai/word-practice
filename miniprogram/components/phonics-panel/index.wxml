<view class="guide" wx:if="{{text}}"><text>① 找元音　② 一靠后、二分手、组合算一个　③ 定读音</text><view wx:for="{{rows}}" wx:key="index" wx:for-index="row" class="entry"><text class="name">{{item.word}}　{{item.ipa}}</text><view>元音字母：{{item.vowels || '无 a e i o u'}}</view><view class="cuts"><text wx:for="{{item.letters}}" wx:key="index" data-row="{{row}}" data-at="{{index}}" bindtap="cut">{{item}} · </text></view><view>{{item.parts}}</view><view>{{item.rule}}</view><view>{{item.note}}</view><view class="actions"><button size="mini" data-row="{{row}}" bindtap="check">核对试切</button><button size="mini" data-row="{{row}}" bindtap="reference">看参考</button></view><text>{{item.feedback}}</text></view></view>