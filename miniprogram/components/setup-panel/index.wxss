/* Consistent type scale: title 36, controls 30, wheel 34 rpx. */
.overlay {position:fixed;top:0;right:0;bottom:0;left:0;z-index:20;background:rgba(0,0,0,.65);display:flex;align-items:center;justify-content:center;padding:24rpx;padding-bottom:calc(24rpx + env(safe-area-inset-bottom));}
.panel {width:100%;max-width:660rpx;max-height:85vh;box-sizing:border-box;background:#2c3340;color:#edf0f5;border-radius:24rpx;padding:32rpx;}
.title {display:block;font-size:36rpx;font-weight:600;line-height:1.4;margin-bottom:16rpx;}
.fields {max-height:54vh;}
.setting-row {display:flex;align-items:center;gap:16rpx;min-height:100rpx;padding:24rpx 0;border-bottom:1rpx solid #414957;box-sizing:border-box;font-size:30rpx;line-height:1.5;font-weight:400;}
.setting-label {flex:0 0 128rpx;color:#b7c0ce;white-space:nowrap;}
.setting-value {flex:1;min-width:0;color:#edf0f5;overflow-wrap:break-word;}
.setting-arrow {flex:0 0 16rpx;color:#9ba6b8;text-align:right;font-size:30rpx;}
.start-button {display:block;width:100%;max-width:none;margin:24rpx 0 0;padding:0 24rpx;height:88rpx;line-height:88rpx;border-radius:14rpx;background:#b5dbc1;color:#24352c;font-size:30rpx;font-weight:500;}
.start-button::after,.choice-button::after {border:0;}
.choice-backdrop {position:fixed;top:0;left:0;right:0;bottom:0;z-index:30;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;}
.choice-sheet {width:100%;background:#2c3340;color:#edf0f5;border-radius:24rpx 24rpx 0 0;padding-bottom:env(safe-area-inset-bottom);}
.choice-actions {display:flex;justify-content:space-between;border-bottom:1rpx solid #414957;padding:8rpx 20px;}
.choice-button {flex:0 0 auto;box-sizing:border-box;width:auto;max-width:none;margin:0;padding:0;height:88rpx;line-height:88rpx;background:transparent;color:#b7c0ce;font-size:30rpx;font-weight:400;}
.choice-button.confirm {color:#b5dbc1;font-weight:500;}
.choice-wheel {height:320px;width:100%;background:#2c3340;}
.choice-option {display:flex;align-items:center;justify-content:center;padding:0 24rpx;font-size:34rpx;line-height:1.5;font-weight:400;text-align:center;color:#b7c0ce;}
.choice-option.selected {color:#b5dbc1;font-weight:500;}

.choice-action-group {width:100%;display:flex;align-items:center;justify-content:space-between;}
