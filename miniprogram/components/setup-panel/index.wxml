<view wx:if="{{visible}}" class="overlay"><view class="panel" catchtap="block"><text class="title">开始默写</text><scroll-view scroll-y="{{true}}" class="fields"><view class="setting-row" data-key="unitIndex" catchtap="openChoice"><text class="setting-label">学习单元</text><text class="setting-value">{{units[unitIndex].title}}</text><text class="setting-arrow">›</text></view><view class="setting-row" data-key="scopeIndex" catchtap="openChoice"><text class="setting-label">学习范围</text><text class="setting-value">{{scopes[scopeIndex]}}</text><text class="setting-arrow">›</text></view><view class="setting-row" data-key="modeIndex" catchtap="openChoice"><text class="setting-label">练习方式</text><text class="setting-value">{{modes[modeIndex]}}</text><text class="setting-arrow">›</text></view><view class="setting-row" data-key="directionIndex" catchtap="openChoice"><text class="setting-label">默写方向</text><text class="setting-value">{{directions[directionIndex]}}</text><text class="setting-arrow">›</text></view><view class="setting-row" data-key="countIndex" catchtap="openChoice"><text class="setting-label">本轮题量</text><text class="setting-value">{{counts[countIndex]}}</text><text class="setting-arrow">›</text></view></scroll-view><button class="start-button" bindtap="start">开始练习</button></view></view><view wx:if="{{visible && choiceOpen}}" class="choice-backdrop" bindtap="cancelChoice"><view class="choice-sheet" catchtap="block"><view class="choice-actions"><view class="choice-action-group"><view class="choice-button" catchtap="cancelChoice">取消</view><view class="choice-button confirm" catchtap="confirmChoice">确定</view></view></view><picker-view class="choice-wheel" mask-style="background-image:none;background-color:transparent;" value="{{choiceValue}}" indicator-style="height:64px;" bindchange="changeChoice"><picker-view-column><view wx:for="{{choiceOptions}}" wx:key="index" class="choice-option {{index===choiceValue[0]?'selected':''}}">{{item}}</view></picker-view-column></picker-view></view></view>