.grid {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 32rpx 24rpx;
  padding: 32rpx 0;
}
.word {
  position: relative;
  max-width: 100%;
  padding-top: 48rpx;
}
.letters {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6rpx;
}
.cell {
  display: inline-block;
  width: 34rpx;
  flex-shrink: 0;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 44rpx;
  border-bottom: 3rpx solid #8993a4;
}
.invalid {
  border-color: #ed8f89;
}
.valid {
  color: #b5dbc1;
  border-color: #b5dbc1;
}
.punct {
  border: 0;
  min-width: 8rpx;
}
.tag {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  border-radius: 30rpx;
  padding: 5rpx 16rpx;
  font-size: 23rpx;
  color: #202532;
}
.keyboard {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 1rpx;
  opacity: 0.01;
}
.focused {
  outline: 2rpx solid #b5dbc1;
  outline-offset: 4rpx;
}
