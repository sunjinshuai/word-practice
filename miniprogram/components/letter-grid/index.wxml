<view class="grid" bindtap="focus"><view wx:for="{{words}}" wx:key="index" class="word"><text wx:if="{{judged && ok}}" class="tag" style="background:{{item.color}}">{{item.pos}}</text><view class="letters"><text wx:for="{{item.cells}}" wx:for-item="cell" wx:key="index" class="cell {{item.invalid?'invalid':''}} {{item.valid?'valid':''}} {{cell.focused?'focused':''}} {{!cell.editable?'punct':''}}">{{cell.char || ' '}}</text></view></view><input wx:if="{{!judged}}" class="keyboard" value="{{value}}" cursor="{{value.length}}" focus="{{focused}}" maxlength="300" adjust-position="{{true}}" cursor-spacing="40" bindinput="input" /></view>